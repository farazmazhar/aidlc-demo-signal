# Build Signal — single configuration source for host scripts and the Lambda/emulator environments.
# Committed deliberately: the spike holds no secrets (NFR5).
# Host scripts load it with `bun --env-file=config/config.env <script>`;
# infra/config.ts parses it and derives the Lambda environments from the `_LAMBDA` pairs.

# --- Provider selection (FR6.1) ---
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- Local provider endpoints ---
# Host scripts reach the host-published port; Lambda containers reach the container alias.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL_LAMBDA=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Bedrock model ids (used only when the provider selection is `bedrock`; not exercised locally) ---
BEDROCK_CHAT_MODEL=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# --- AWS / emulator ---
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# Lambda containers reach the emulator through the compose network alias rather
# than through the host port, so the same value works from inside a function.
AWS_ENDPOINT_URL_LAMBDA=http://emulator:4566

# --- Vector store ---
# 768 for nomic-embed-text, 1024 for amazon.titan-embed-text-v2:0.
EMBEDDING_DIMENSIONS=768
DATABASE_URL=postgres://signal:signal@localhost:5432/signal
DATABASE_URL_LAMBDA=postgres://signal:signal@postgres:5432/signal
POSTGRES_USER=signal
POSTGRES_PASSWORD=signal
POSTGRES_DB=signal

# --- DynamoDB ---
FEEDBACK_TABLE=signal-feedback

# --- Weekly clustering job ---
CLUSTER_SIMILARITY_THRESHOLD=0.82
CLUSTER_MIN_SIZE=2
CLUSTER_WINDOW_DAYS=7
DASHBOARD_TREND_WEEKS=8

# --- API Gateway / Scheduler / SES ---
# Runtime for both Lambda functions. The pinned emulator image does not accept
# nodejs22.x in its runtime enum, so the default is the newest value it serves.
LAMBDA_RUNTIME=nodejs20.x
SCHEDULE_CRON=cron(0 6 ? * MON *)
SES_SENDER=signal@example.com
API_STAGE_NAME=local
# Measured on this emulator build: `_aws/execute-api/<id>/<stage>/…` answers 200
# with an empty body and never routes to the integration, while the
# `/restapis/<id>/<stage>/_user_request_/…` form routes correctly (risk R10).
LOCAL_API_URL_STYLE=_user_request_

# --- Emulator container ---
# Token-free community-era image; override to try a different emulator build.
EMULATOR_IMAGE=localstack/localstack:3.8.1
